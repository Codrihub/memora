# Settings for docker-compose.yml. Copy to .env and uncomment what you need:
#   cp .env.example .env
# Every value is optional; the defaults are shown. Never commit your .env.

# ---- Compose (host side) -----------------------------------------------------

# Project name, used as the prefix of container, network and volume names.
# COMPOSE_PROJECT_NAME=memora

# Image to run. Pin a release for reproducible upgrades, or use a local build
# (IMAGE=memora:local docker compose up -d --build).
# IMAGE=ghcr.io/codrihub/memora:1.0.0

# Host port for the single front door. Use 127.0.0.1:8400 when a reverse proxy
# on the same host is the only entry point.
# MEMORA_HTTP_PORT=8400

# Host directories mounted at /data (vault) and /state (memora.db, backups).
# Both must exist and belong to MEMORA_UID:MEMORA_GID.
# MEMORA_DATA_DIR=./data
# MEMORA_STATE_DIR=./state

# uid:gid the container runs as. Match the owner of the host directories:
#   stat -c '%u:%g' data state
# MEMORA_UID=1000
# MEMORA_GID=1000

# ---- Memora (passed into the container) -------------------------------------
# A value stored with `memora-cli` -> /config wins over the same key here;
# clear it in /config to fall back to this file.

# Public URL when Memora sits behind a reverse proxy. Its host also becomes an
# allowed domain.
# MEMORA_BASE_URL=https://memory.example.com

# Allowed hostnames, comma separated (*.example.com works). Requests for any
# other Host, including the bare IP, get 404. Localhost always works.
# Empty: any host.
# MEMORA_DOMAIN=memory.example.com

# IPs of remote reverse proxies whose X-Forwarded-For / CF-Connecting-IP is
# trusted, comma separated. Loopback is always trusted.
# MEMORA_TRUSTED_PROXIES=

# Accepted and stored (30-86400) but not used yet: the setup / reset window
# length comes from `memora-cli setup --minutes N` (default 5 minutes).
# MEMORA_ARM_TTL=300

# true: use /data as the vault right away instead of asking for the folder in
# the browser after the first sign-in.
# MEMORA_VAULT_AUTO=false

# Text shown on the login screen while the instance still needs setup.
# MEMORA_SETUP_HINT=docker compose exec -it gateway memora-cli

# Check GitHub for a newer Memora release (every 6 hours) and show it in the
# web UI. false: never contact GitHub.
# MEMORA_UPDATE_CHECK=true

# Owner account created at startup, only when no owner exists yet. The password
# (at least 10 characters) is hashed with argon2id and never stored. Prefer the
# _FILE variant pointing at a mounted secret so the password is not in the
# environment.
# MEMORA_ADMIN_USER=admin
# MEMORA_ADMIN_PASSWORD=
# MEMORA_ADMIN_PASSWORD_FILE=/run/secrets/memora_admin_password

# API key for agents (MCP) installed at startup, at least 24 characters. Only
# its SHA-256 hash is stored. You can also create keys with `memora-cli` -> /keys
# or in the web UI.
# MEMORA_API_KEY=
# MEMORA_API_KEY_FILE=/run/secrets/memora_api_key

# Log filter: error, warn, info, debug, trace, or per module (memora=debug).
# RUST_LOG=info
